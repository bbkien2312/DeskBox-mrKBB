<Window
    x:Class="DeskBox.Views.ScreenshotCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="DeskBox Screenshot">
    <Grid x:Name="RootGrid" Background="Black">
        <!-- Ảnh nền được chụp trước khi overlay hiện ra: màn hình đứng yên nhưng vẫn nhìn rõ để chọn cửa sổ. -->
        <Image
            x:Name="FrozenScreenImage"
            Stretch="Fill"
            PointerMoved="FrozenScreenImage_PointerMoved"
            PointerPressed="FrozenScreenImage_PointerPressed"
            PointerReleased="FrozenScreenImage_PointerReleased" />
        <Rectangle Fill="#16000000" IsHitTestVisible="False" />
        <Border
            x:Name="SelectionBorder"
            Background="#1829B6F6"
            BorderBrush="#FF29B6F6"
            BorderThickness="3"
            IsHitTestVisible="False"
            Visibility="Collapsed" />
        <Border
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,24,24,0"
            Padding="12,8"
            Background="#EE202020"
            CornerRadius="8">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock
                    x:Name="SelectionHintText"
                    VerticalAlignment="Center"
                    MaxWidth="360"
                    Foreground="White"
                    Text="Bấm chọn cửa sổ, hoặc kéo chuột để cắt vùng tự do"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="CopyButton"
                    Click="CopyButton_Click"
                    Content="Sao chép (Ctrl+C)"
                    Visibility="Collapsed" />
                <Button
                    x:Name="SaveButton"
                    Click="SaveButton_Click"
                    Content="Lưu..."
                    Visibility="Collapsed" />
                <Button
                    x:Name="ResetButton"
                    Click="ResetButton_Click"
                    Content="Chọn lại"
                    Visibility="Collapsed" />
                <Button
                    Click="CancelButton_Click"
                    Content="Hủy" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
