<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeskBox.Controls.DesktopOrganizationTaskView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:DeskBox.Services">

    <UserControl.Resources>
        <Style x:Key="DesktopOrganizationTargetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="DesktopOrganizationSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Padding="28,16,12,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="ResultInfo" IsClosable="True" IsOpen="False" />

        <Grid
            x:Name="PreviewViewport"
            Grid.Row="1"
            SizeChanged="PreviewViewport_SizeChanged">
            <ScrollViewer
                x:Name="PreviewScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto"
                VerticalScrollMode="Auto"
                SizeChanged="PreviewScrollViewer_SizeChanged">
                <StackPanel x:Name="PreviewContent" Spacing="14">
                    <Grid ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock
                                x:Name="SummaryTitle"
                                FontSize="22"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="SummaryDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="ExcludedItemsButton"
                            Grid.Column="1"
                            Padding="10,6"
                            FontSize="13"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Visibility="Collapsed"
                            Click="ExcludedItemsButton_Click" />
                    </Grid>

                    <Grid
                        x:Name="TargetRows"
                        ColumnSpacing="12"
                        RowSpacing="12"
                        Padding="0,0,8,0"
                        SizeChanged="TargetRows_SizeChanged" />

                    <Grid x:Name="BottomInfoGrid">
                        <StackPanel Spacing="8">
                            <CheckBox
                                x:Name="IncludeManagedWidgetItemsCheckBox"
                                IsChecked="False"
                                svc:Localized.Key="DesktopOrganization.Preview.ManagedWidgetOption" />
                            <TextBlock
                                Margin="0,-4,0,0"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                svc:Localized.Key="DesktopOrganization.Preview.ManagedWidgetOptionDescription" />
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="StorageSectionTitleText"
                                    FontSize="16"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="StorageSectionDescriptionText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Border
                                x:Name="StoragePathCard"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,12">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <FontIcon FontSize="18" Glyph="&#xE8B7;" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="PathTitleText"
                                            FontWeight="SemiBold"
                                            />
                                        <TextBlock
                                            x:Name="StoragePathText"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    </StackPanel>
                                    <Button
                                        x:Name="ChangePathButton"
                                        Grid.Column="2"
                                        Click="ChangePathButton_Click" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <StackPanel
                x:Name="ScanBusyPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="10">
                <ProgressRing Width="30" Height="30" IsActive="True" />
                <TextBlock
                    x:Name="ScanBusyText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    />
            </StackPanel>
        </Grid>

        <StackPanel
            x:Name="ExecutionProgressPanel"
            Grid.Row="2"
            Spacing="7"
            Visibility="Collapsed">
            <ProgressBar x:Name="ExecutionProgressBar" Maximum="1" Minimum="0" Value="0" />
            <TextBlock
                x:Name="ExecutionProgressText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid x:Name="FooterCommandSurface" Grid.Row="3">
            <Border
                x:Name="FooterAcrylicSurface"
                Background="{ThemeResource SystemControlAcrylicElementBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10"
                IsHitTestVisible="False"
                Opacity="0.5" />
            <Grid Padding="12,9" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click" />
                <Button
                    x:Name="UndoButton"
                    Grid.Column="1"
                    Click="UndoButton_Click"
                    Visibility="Collapsed" />
                <Button
                    x:Name="CancelButton"
                    Grid.Column="2"
                    Click="CancelButton_Click" />
                <Button
                    x:Name="DoneButton"
                    Grid.Column="2"
                    Click="DoneButton_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="Collapsed" />
                <Button
                    x:Name="ExecuteButton"
                    Grid.Column="3"
                    Click="ExecuteButton_Click"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
