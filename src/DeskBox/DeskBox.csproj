<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Keep the compile-time SDK modern while declaring the supported Win10 floor explicitly. -->
    <SupportedOSPlatformVersion>10.0.19044.0</SupportedOSPlatformVersion>
    <RootNamespace>DeskBox</RootNamespace>
    <!-- The fork has its own comparable version while retaining the exact
         upstream version in assembly metadata for diagnostics and updates. -->
    <DeskBoxUpstreamVersion Condition="'$(DeskBoxUpstreamVersion)' == ''">1.4.2</DeskBoxUpstreamVersion>
    <DeskBoxForkVersion Condition="'$(DeskBoxForkVersion)' == ''">1.4.2.1</DeskBoxForkVersion>
    <DeskBoxForkDisplayVersion Condition="'$(DeskBoxForkDisplayVersion)' == ''">1.4.2.1-fork.8</DeskBoxForkDisplayVersion>
    <DeskBoxForkBuildNumber Condition="'$(DeskBoxForkBuildNumber)' == ''">8</DeskBoxForkBuildNumber>
    <!-- Keep the update wire contract stable across fork builds. Increase
         this only when a future updater can no longer read old manifests. -->
    <DeskBoxUpdaterProtocolVersion Condition="'$(DeskBoxUpdaterProtocolVersion)' == ''">1</DeskBoxUpdaterProtocolVersion>
    <DeskBoxBuildNumber Condition="'$(DeskBoxBuildNumber)' == ''">dev</DeskBoxBuildNumber>
    <DeskBoxUpstreamCommit Condition="'$(DeskBoxUpstreamCommit)' == ''">unknown</DeskBoxUpstreamCommit>
    <DeskBoxForkCommit Condition="'$(DeskBoxForkCommit)' == ''">unknown</DeskBoxForkCommit>
    <Version>$(DeskBoxForkVersion)</Version>
    <AssemblyVersion Condition="'$(DeskBoxForkAssemblyVersion)' == ''">$(DeskBoxForkVersion)</AssemblyVersion>
    <FileVersion Condition="'$(DeskBoxForkAssemblyVersion)' == ''">$(DeskBoxForkVersion)</FileVersion>
    <InformationalVersion>$(DeskBoxForkDisplayVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <PublishSingleFile>false</PublishSingleFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AppxPackage>false</AppxPackage>
    <DeskBoxDistribution Condition="'$(DeskBoxDistribution)' == ''">Direct</DeskBoxDistribution>
    <DefineConstants Condition="'$(DeskBoxDistribution)' == 'Store'">$(DefineConstants);DESKBOX_STORE</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\deskbox.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    .NET's COM-wrapper debugger table is intentionally append-only. WinUI apps
    can otherwise retain every managed wrapper for the lifetime of the process,
    so production builds disable that debugger-only tracking surface.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DeskBoxDistribution)' == 'Store'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AppxPackageSigningEnabled Condition="'$(AppxPackageSigningEnabled)' == ''">false</AppxPackageSigningEnabled>
    <UapAppxPackageBuildMode Condition="'$(UapAppxPackageBuildMode)' == ''">SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackage Condition="'$(DeskBoxCreateMsixPackage)' == 'true'">true</AppxPackage>
    <GenerateAppxPackageOnBuild Condition="'$(DeskBoxCreateMsixPackage)' == 'true'">true</GenerateAppxPackageOnBuild>
    <AppxBundle Condition="'$(DeskBoxCreateMsixPackage)' == 'true' and '$(AppxBundle)' == ''">Never</AppxBundle>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DeskBox.UpstreamVersion" Value="$(DeskBoxUpstreamVersion)" />
    <AssemblyMetadata Include="DeskBox.ForkVersion" Value="$(DeskBoxForkVersion)" />
    <AssemblyMetadata Include="DeskBox.ForkDisplayVersion" Value="$(DeskBoxForkDisplayVersion)" />
    <AssemblyMetadata Include="DeskBox.ForkBuildNumber" Value="$(DeskBoxForkBuildNumber)" />
    <AssemblyMetadata Include="DeskBox.UpdaterProtocolVersion" Value="$(DeskBoxUpdaterProtocolVersion)" />
    <AssemblyMetadata Include="DeskBox.BuildNumber" Value="$(DeskBoxBuildNumber)" />
    <AssemblyMetadata Include="DeskBox.UpstreamCommit" Value="$(DeskBoxUpstreamCommit)" />
    <AssemblyMetadata Include="DeskBox.ForkCommit" Value="$(DeskBoxForkCommit)" />
    <PackageReference Include="CommunityToolkit.WinUI.Animations" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.ColorPicker" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Segmented" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2270" />
    <PackageReference Include="H.NotifyIcon.WinUI" Version="2.5.0-beta.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\deskbox.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\deskbox.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\deskbox-tray-light.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\deskbox-tray-dark.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\deskbox-tray-light.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\deskbox-tray-dark.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\wechat-qrcode.jpg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\SettingsNavIcons\*.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\WidgetTitleIcons\*.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Store\*.png" />
    <EmbeddedResource Include="Assets\Cities\cities.json" />
<EmbeddedResource Include="Strings\zh-CN.json" />
<EmbeddedResource Include="Strings\en-US.json" />
<EmbeddedResource Include="Strings\ja-JP.json" />
<EmbeddedResource Include="Strings\de-DE.json" />
<EmbeddedResource Include="Strings\pt-BR.json" />
<EmbeddedResource Include="Strings\hi-IN.json" />
<EmbeddedResource Include="Strings\es-ES.json" />
<EmbeddedResource Include="Strings\fr-FR.json" />
<EmbeddedResource Include="Strings\ar-SA.json" />
<EmbeddedResource Include="Strings\bn-BD.json" />
<EmbeddedResource Include="Strings\ru-RU.json" />
<EmbeddedResource Include="Strings\vi-VN.json" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- PRI resources (.resw) in Resources/ subdirectories are auto-included by the .NET SDK -->
  <!-- They provide AppDisplayName and AppDescription for the MSIX manifest's ms-resource: references -->

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)' != 'true' and '$(EnableMsixTooling)' == 'true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <Target Name="BuildDeskBoxUpdater" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' != 'Store'">
    <MSBuild
      Projects="..\DeskBox.Updater\DeskBox.Updater.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier)" />
  </Target>

  <Target Name="CopyDeskBoxUpdater" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' != 'Store'">
    <ItemGroup>
      <DeskBoxUpdaterOutput Include="..\DeskBox.Updater\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\DeskBox.Updater.*" Condition="'$(RuntimeIdentifier)' != ''" />
      <DeskBoxUpdaterOutput Include="..\DeskBox.Updater\bin\$(Platform)\$(Configuration)\$(TargetFramework)\DeskBox.Updater.*" Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' != 'AnyCPU' and '$(Platform)' != ''" />
      <DeskBoxUpdaterOutput Include="..\DeskBox.Updater\bin\$(Configuration)\$(TargetFramework)\DeskBox.Updater.*" Condition="'$(RuntimeIdentifier)' == '' and ('$(Platform)' == 'AnyCPU' or '$(Platform)' == '')" />
    </ItemGroup>
    <Copy SourceFiles="@(DeskBoxUpdaterOutput)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishDeskBoxUpdater" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and '$(DeskBoxDistribution)' != 'Store'">
    <MSBuild
      Projects="..\DeskBox.Updater\DeskBox.Updater.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishSingleFile=false;PublishDir=$(PublishDir)" />
  </Target>

</Project>
